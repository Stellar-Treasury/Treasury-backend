# ─────────────────────────────────────────────────────────────────────────────
# DAO Treasury Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# Variables marked [required] must be set before the server will start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1

# ── Database [required] ───────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://dao_user:dao_pass@localhost:5432/dao_treasury

# ── Stellar / Soroban [required] ──────────────────────────────────────────────
STELLAR_NETWORK=testnet       # testnet | mainnet | futurenet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Ledger to start indexing from (0 = beginning, set to current ledger for fresh deploy)
INDEXER_START_LEDGER=0
# How often to poll for new events in milliseconds
INDEXER_POLL_MS=5000

# ── Security ──────────────────────────────────────────────────────────────────
# Optional API key for write endpoints (POST /proposals, POST /approve, etc.)
# Leave empty to disable key check during local development.
API_KEY=your-secret-api-key-here

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://your-dao-frontend.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000    # 1 minute window
RATE_LIMIT_MAX=100            # max requests per window per IP

# ── Email Notifications (optional) ───────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications entirely.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# From address shown in notification emails
NOTIFY_FROM=dao-alerts@yourdomain.com

# Comma-separated list of emails to notify on new proposals / executions
NOTIFY_TO=signer1@example.com,signer2@example.com
